# Local secrets (not committed to git)
# Copy this file to .env.local and paste your real keys:
#
# EXPO_PUBLIC_MAPTILER_API_KEY=
# EXPO_PUBLIC_MAPTILER_STYLE_ID=hybrid-v4
# EXPO_PUBLIC_MAPTILER_STREET_STYLE_ID=streets-v4
# EXPO_PUBLIC_GEOAPIFY_API_KEY=
#
# Or set EXPO_PUBLIC_MAPTILER_API_KEY in `.env` and restart:
#   npx expo start --dev-client --clear --host lan
