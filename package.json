{
  "name": "bhuguard-mobile",
  "version": "1.2.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@maplibre/maplibre-react-native": "^11.3.6",
