# Bhuguard Mobile — local environment template
# Copy to `.env` on every computer before starting Expo:
#   Copy-Item .env.example .env
#
# Do NOT put database passwords, Laravel secrets, user passwords,
# MPIN values, OTP codes, auth tokens, or signing passwords here.

# Local Laravel (development). Production builds use erp.bhuguard.com via EAS.
EXPO_PUBLIC_APP_URL=https://erp.bhuguard.com
EXPO_PUBLIC_API_URL=https://erp.bhuguard.com/api

# Optional app variant for Expo / EAS profiles:
EXPO_PUBLIC_APP_VARIANT=development
# EXPO_PUBLIC_APP_VARIANT=demo
# EXPO_PUBLIC_APP_VARIANT=production

# MapLibre / MapTiler (Field Officer farm boundary maps)
# Replace with your team MapTiler key — never commit private server secrets.
EXPO_PUBLIC_MAPTILER_API_KEY=your_maptiler_api_key_here
EXPO_PUBLIC_MAPTILER_STYLE_ID=hybrid-v4
EXPO_PUBLIC_MAPTILER_HYBRID_STYLE_ID=hybrid-v4
EXPO_PUBLIC_MAPTILER_STREET_STYLE_ID=streets-v4

# Optional native MapView screens (NOT Farm Boundary Hybrid):
EXPO_PUBLIC_USE_NATIVE_MAPS=false
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GEOAPIFY_API_KEY=

# Development-only helpers (keep false for production builds):
# EXPO_PUBLIC_ENABLE_DEMO_LOGIN=false
# EXPO_PUBLIC_ENABLE_DEMO_CONSENT_OTP=false
# EXPO_PUBLIC_DEMO_CONSENT_OTP=
