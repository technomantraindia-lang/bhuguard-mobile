# Copy to .env for local Expo Go / dev-client runs.
#
# --- Works on ANY phone (mobile data / any Wi-Fi) ---
# Deploy Laravel publicly, then set:
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api
#
# --- Local testing (same Wi-Fi only) ---
# EXPO_PUBLIC_API_URL=http://192.168.1.18:8000/api
#
# You can also change the API URL on the login screen without rebuilding.
EXPO_PUBLIC_API_URL=http://192.168.1.18:8000/api
