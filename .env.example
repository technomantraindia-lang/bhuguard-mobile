# Copy one of these to `.env` for local Expo runs:
#
#   development  →  copy .env.development
#   demo/client  →  copy .env.demo
#
# --- Production / TestFlight / App Store (default) ---
# Replace yourdomain.com with your live API domain before building.
EXPO_PUBLIC_APP_VARIANT=production
EXPO_PUBLIC_API_URL=https://yourdomain.com/api
#
# --- Demo / client (internet, no tunnel) ---
# EXPO_PUBLIC_APP_VARIANT=demo
# EXPO_PUBLIC_API_URL=https://demo.bhuguard.com/api
#
# --- Local dev (same Wi‑Fi only) ---
# EXPO_PUBLIC_APP_VARIANT=development
# EXPO_PUBLIC_API_URL=http://YOUR-PC-IP:8000/api
# EXPO_PUBLIC_DEV_LOCAL_API_URL=http://YOUR-PC-IP:8000/api
#
# Server settings on the login screen can override the URL without rebuilding.
