# Bhuguard QA Test Center — local secrets (DO NOT COMMIT)
# Copy to .env.qa and fill values. Never put production OTP in git.

QA_API_BASE_URL=https://erp.bhuguard.com/api
QA_TEST_MODE=read-only
QA_ALLOW_WRITES=false
QA_TEST_ENVIRONMENT=production-read-only
QA_TEST_DATA_PREFIX=BHG-QA-
QA_CLEANUP_TEST_DATA=true

# Optional local backend root override
# QA_BACKEND_ROOT=C:\Users\Admin\Desktop\bhuguard-latest

QA_FARMER_MOBILE=
QA_FIELD_OFFICER_MOBILE=
QA_ARTISAN_MOBILE=
QA_ARTISAN_PRO_MOBILE=

QA_TEST_OTP_ENABLED=false
QA_TEST_OTP=

QA_TEST_PATTERN_ENABLED=false
QA_TEST_PATTERN=

# Timeouts (ms)
QA_COMMAND_TIMEOUT_MS=300000
QA_STALL_TIMEOUT_MS=300000
